      "id": "head_from_pressure_and_density",
      "output": "pump_head",
      "equation": "H = ΔP / (ρ g)",
      "requires": [
        "pump_pressure_difference",
        "liquid_density"
      ],
      "conditions": "ΔP tiene que estar definido entre dos puntos identificados y la densidad tiene que corresponder a ese tramo.",
