# Puertos publicados en el host Fedora.
# Dentro de la red de contenedores, esp-web usa http://esp-core:8080.
# Ese nombre no debe cambiarse por localhost.
ESP_CORE_HOST_PORT=8080
ESP_WEB_HOST_PORT=8000

# Solo desarrollo educativo. Cámbiela si expone el servicio fuera de su máquina.
DJANGO_SECRET_KEY=dev-educational-only-change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

ESP_CORE_TIMEOUT=3
LOG_LEVEL=INFO

# Raíz de los datasets dentro del contenedor esp-core.
# Compose la fija en /app/data y monta ./data solo en ese servicio.
# El montaje es escribible para poder importar. La aplicación no abre
# los RAW en modo escritura: la inmutabilidad se exige en el código.
# ESP_DATA_ROOT=/app/data

# Tamaño máximo de cada archivo importado, en megabytes. No hay otro tope oculto.
ESP_DATA_MAX_UPLOAD_MB=32
